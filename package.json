{
  "name": "nightshade-horror-shorts",
  "version": "1.0.0",
  "description": "Turn horror stories into animated 10-60s vertical short videos with procedural visuals, sound design and captions.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p .",
    "test": "tsx --test tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autopilotlabs-dev/Shorts_generator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/autopilotlabs-dev/Shorts_generator/issues"
  },
  "homepage": "https://github.com/autopilotlabs-dev/Shorts_generator#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "express": "^5.2.1",
    "fix-webm-duration": "^1.0.6",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
