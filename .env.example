# Required
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@localhost:5432/nightshade
REDIS_URL=redis://localhost:6379

# AI (optional: without keys the app uses the built-in planner and procedural visuals, no narration)
ANTHROPIC_API_KEY=             # Claude scene director
OPENAI_API_KEY=                # narration (gpt-4o-mini-tts) + scene images (gpt-image-1-mini)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=medium  # low ($0.006) | medium ($0.015) per 1024x1536 image

# Storage: "local" (DATA_DIR/media) or "s3" (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
# DATA_DIR=./data
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Render worker
# INTERNAL_APP_URL=http://localhost:3000   # how the worker reaches the web app for signed media (local storage)
# REMOTION_CONCURRENCY=4                    # parallel browser tabs per render (default: half the CPU threads)
# REMOTION_BROWSER_EXECUTABLE=              # use an existing Chrome instead of Remotion's download
# RENDER_JOBS=1                             # videos rendered at the same time per worker
