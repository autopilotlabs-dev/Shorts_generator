# Copy to .env.local (dev) or pass as environment variables (prod). Every key is optional:
# without keys the app still works with the built-in planner, procedural visuals and no narration.

# Claude scene director (story -> timed scenes, visuals, sound cues, image prompts)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Narration (text-to-speech). ElevenLabs is preferred when both are set.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# TTS_PROVIDER=openai          # force a provider, or "none"

# AI scene images (uses OPENAI_API_KEY)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# IMAGE_PROVIDER=none          # disable AI images
# OPENAI_BASE_URL=https://api.openai.com/v1

# Storage: SQLite database + media files
# DATA_DIR=./data

# Rendering
# RENDER_PROCESSES=4           # frame-render processes per video (default: CPU count)
# RENDER_WORKERS=1             # videos rendered at the same time
# X264_PRESET=veryfast
# FFMPEG_PATH=ffmpeg

# Set to 1 only when serving production over plain HTTP (not localhost)
# INSECURE_COOKIES=1
